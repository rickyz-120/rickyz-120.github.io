{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "posts.schema.json",
  "title": "data/posts.json",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "slug": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "title": {
        "$ref": "common.schema.json#/$defs/text"
      },
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "summary": {
        "$ref": "common.schema.json#/$defs/text"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "file": {
        "type": "object",
        "properties": {
          "pt": {
            "type": "string",
            "pattern": "^content/posts/.+\\.md$"
          },
          "en": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^content/posts/.+\\.md$"
          }
        },
        "required": [
          "pt"
        ],
        "additionalProperties": false
      },
      "draft": {
        "type": "boolean"
      }
    },
    "required": [
      "slug",
      "title",
      "date",
      "summary",
      "file",
      "draft"
    ],
    "additionalProperties": false
  }
}
