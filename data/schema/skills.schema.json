{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skills.schema.json",
  "title": "data/skills.json (sem nível, só a lista por categoria)",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "label": {
        "$ref": "common.schema.json#/$defs/text"
      },
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "common.schema.json#/$defs/text"
            }
          ]
        },
        "description": "Texto simples ou {pt, en} quando o nome muda com o idioma"
      },
      "draft": {
        "type": "boolean",
        "description": "true = lista incompleta: mostra o chip 'mais em breve'"
      }
    },
    "required": [
      "id",
      "label",
      "items"
    ],
    "additionalProperties": false
  }
}
